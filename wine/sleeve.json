{
  "name": "Wine",
  "description": "Runs the Windows version of a game on a Mac with a bundled Wine (an Intel build; Apple silicon uses Rosetta 2). Each download gets its own Windows environment next to the game.",
  "runtimes": {
    "wine": {
      "name": "Wine",
      "license": "LGPL-2.1-or-later AND MPL-2.0 AND MIT",
      "source": "https://dl.winehq.org/wine/source/11.0/wine-11.0.tar.xz",
      "pins": [
        {
          "version": "11.0.1",
          "platform": "macos",
          "import": "fetch",
          "release": "https://github.com/Gcenx/macOS_Wine_builds/releases/download/11.0_1/wine-stable-11.0_1-osx64.tar.xz",
          "releaseSha256": "b50dc50ec7f41d58b115a6b685d4d1315ba3c797bd3aa0f49213f2703cb82388",
          "treeSha256": "eb28037e4095b685691707d4989f129e4075017c03ce41be53bfe4206ce41557",
          "root": "Wine Stable.app",
          "program": "Wine Stable.app/Contents/Resources/wine/bin/wine",
          "deliverAs": "wine",
          "url": "https://git.huffs.online/huff-admin/huffun-sleeves/releases/download/sleeve-runtimes-20261016/wine-11.0.1-macos.zip",
          "archiveSha256": "431c7a00adb276f001b166ec30e2fec06522ce46eccc245d0a5e59475704e167"
        }
      ]
    }
  },
  "templates": {
    "launch-macos": {
      "file": "templates/launch-macos.command",
      "escape": "sh"
    },
    "how-macos": {
      "file": "templates/how-to-play.txt",
      "escape": "text"
    }
  },
  "detect": {
    "select": "one",
    "profiles": [
      {
        "name": "Client-installed offline payload",
        "priority": 20,
        "anchor": {
          "file": "setup_*.exe"
        },
        "checks": [
          {
            "pe": "{{anchor.path}}"
          },
          {
            "peResource": "{{anchor.path}}",
            "type": 10,
            "id": 11111,
            "hex": "72446c507453cde6d77b0b2a"
          }
        ],
        "params": {
          "exe": {
            "path": "{{anchor.path}}"
          },
          "installer": "yes",
          "software": "no"
        },
        "label": "{{params.exe}}"
      },
      {
        "name": "Unity game without Steamworks",
        "priority": 10,
        "anchor": {
          "dir": "*_Data"
        },
        "checks": [
          {
            "file": "{{anchor.name|replace:\"_Data$\":\".exe\"}}",
            "capture": "exe",
            "label": "the program beside the _Data folder"
          },
          {
            "magic": "{{cap.exe}}",
            "at": {
              "u32le": 60
            },
            "ascii": "PE",
            "evidence": true,
            "label": "Windows program"
          },
          {
            "peImports": "{{cap.exe}}",
            "includes": [
              "ddraw.dll"
            ],
            "capture": "draw",
            "optional": true
          }
        ],
        "params": {
          "exe": {
            "path": "{{cap.exe}}"
          },
          "software": "{{#if cap.draw}}yes{{else}}no{{/if}}"
        },
        "label": "{{params.exe}}"
      },
      {
        "name": "Steam DOSBox launch script",
        "priority": 5,
        "anchor": {
          "file": "*.bat",
          "exclude": [
            "testapp*.bat"
          ]
        },
        "checks": [
          {
            "text": "{{anchor.path}}",
            "regex": "dosbox[^\\r\\n]*-conf",
            "flags": "i",
            "evidence": true,
            "label": "starts DOSBox with a configuration"
          }
        ],
        "params": {
          "exe": {
            "path": "{{anchor.path}}"
          },
          "software": "yes"
        },
        "label": "{{params.exe}}"
      },
      {
        "name": "Windows program at the top level, without Steamworks",
        "anchor": {
          "file": "*.exe",
          "exclude": [
            "unins*.exe",
            "*setup*.exe",
            "*install*.exe",
            "*patch*.exe",
            "*config*.exe",
            "*crash*.exe",
            "createdump.exe",
            "*redist*.exe",
            "testapp.exe",
            "syscheck.exe",
            "*tools*.exe",
            "dosbox.exe",
            "scummvm.exe"
          ]
        },
        "checks": [
          {
            "magic": "{{anchor.path}}",
            "at": {
              "u32le": 60
            },
            "ascii": "PE",
            "evidence": true,
            "label": "Windows program"
          },
          {
            "peImports": "{{anchor.path}}",
            "includes": [
              "ddraw.dll"
            ],
            "capture": "draw",
            "optional": true
          },
          {
            "glob": "*/*dosbox*.exe",
            "pick": "first",
            "capture": "dosbox_exe",
            "optional": true
          },
          {
            "glob": "*dosbox*.exe",
            "pick": "first",
            "capture": "root_dosbox",
            "optional": true
          },
          {
            "glob": "*/*dosbox*.conf",
            "pick": "first",
            "capture": "dosbox_conf",
            "optional": true
          },
          {
            "glob": "*/*ddraw*.dll",
            "pick": "first",
            "capture": "nested_ddraw",
            "optional": true
          }
        ],
        "params": {
          "exe": {
            "path": "{{anchor.path}}"
          },
          "software": "{{#if cap.draw}}yes{{else}}{{#if cap.dosbox_exe}}yes{{else}}{{#if cap.root_dosbox}}yes{{else}}{{#if cap.dosbox_conf}}yes{{else}}{{#if cap.nested_ddraw}}yes{{else}}no{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
        },
        "label": "{{params.exe}}"
      },
      {
        "name": "Windows program one folder down, without Steamworks",
        "anchor": {
          "file": "*/*.exe",
          "exclude": [
            "*/unins*.exe",
            "*/*setup*.exe",
            "*/*install*.exe",
            "*/*patch*.exe",
            "*/*config*.exe",
            "*/*crash*.exe",
            "*/createdump.exe",
            "*/*redist*.exe",
            "*/testapp.exe",
            "*/syscheck.exe",
            "*/*tools*.exe",
            "*/dosbox.exe",
            "*/scummvm.exe"
          ]
        },
        "checks": [
          {
            "magic": "{{anchor.path}}",
            "at": {
              "u32le": 60
            },
            "ascii": "PE",
            "evidence": true,
            "label": "Windows program"
          },
          {
            "peImports": "{{anchor.path}}",
            "includes": [
              "ddraw.dll"
            ],
            "capture": "draw",
            "optional": true
          },
          {
            "glob": "*/*/*dosbox*.exe",
            "pick": "first",
            "capture": "nested_dosbox",
            "optional": true
          },
          {
            "glob": "*/*dosbox*.exe",
            "pick": "first",
            "capture": "dosbox_exe",
            "optional": true
          },
          {
            "glob": "*/*/*dosbox*.conf",
            "pick": "first",
            "capture": "nested_conf",
            "optional": true
          },
          {
            "glob": "*/*dosbox*.conf",
            "pick": "first",
            "capture": "dosbox_conf",
            "optional": true
          },
          {
            "glob": "*/*/*ddraw*.dll",
            "pick": "first",
            "capture": "nested_ddraw",
            "optional": true
          }
        ],
        "params": {
          "exe": {
            "path": "{{anchor.path}}"
          },
          "software": "{{#if cap.draw}}yes{{else}}{{#if cap.dosbox_exe}}yes{{else}}{{#if cap.nested_dosbox}}yes{{else}}{{#if cap.dosbox_conf}}yes{{else}}{{#if cap.nested_conf}}yes{{else}}{{#if cap.nested_ddraw}}yes{{else}}no{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
        },
        "priority": -10,
        "label": "{{params.exe}}"
      }
    ]
  },
  "deliver": {
    "folder": "{{title}} (Wine)",
    "clients": {
      "macos": {
        "runtimes": [
          "wine"
        ],
        "entries": [
          {
            "template": "launch-macos",
            "to": "Play {{title}}.command",
            "executable": true
          },
          {
            "template": "how-macos",
            "to": "How to play.txt"
          },
          {
            "original": "",
            "to": "game"
          },
          {
            "runtime": "wine"
          }
        ]
      }
    }
  },
  "format": 2,
  "id": "wine",
  "version": 1,
  "preference": 0,
  "scripts": {
    "postinstall": {
      "macos": [
        {
          "file": "scripts/configure.sh",
          "args": [
            "{{params.software|default:\"no\"}}"
          ]
        }
      ]
    }
  },
  "fixtures": [
    {
      "name": "Complete capability data (macos)",
      "client": "macos",
      "state": {
        "os": [
          "windows"
        ],
        "arch": [
          "x86"
        ]
      },
      "files": {
        "program.exe": {
          "hex": ""
        },
        "data.bin": {
          "text": "data"
        }
      },
      "expect": {
        "state": {
          "os": [
            "macos"
          ],
          "arch": [
            "x86_64"
          ]
        },
        "paths": [
          [
            "wine"
          ]
        ],
        "listing": [
          "How to play.txt\tgenerated\t0644",
          "Play Synthetic.command\tgenerated\t0755",
          "game/data.bin\toriginal\t0644",
          "game/program.exe\toriginal\t0644",
          "licenses/Wine.txt\tgenerated\t0644",
          "wine/Contents/Resources/wine/bin/wine\truntime\t0644"
        ]
      }
    },
    {
      "name": "No matching data",
      "client": "macos",
      "state": {
        "os": [
          "windows"
        ],
        "arch": [
          "x86"
        ]
      },
      "files": {},
      "expect": {
        "state": {
          "os": [
            "macos"
          ],
          "arch": [
            "x86_64"
          ]
        },
        "paths": [],
        "listing": []
      }
    }
  ],
  "accepts": {
    "os": {
      "any": [
        "windows"
      ]
    },
    "arch": {
      "any": [
        "x86",
        "x86_64"
      ]
    }
  },
  "produces": {
    "os": {
      "set": [
        "macos"
      ]
    },
    "arch": {
      "set": [
        "x86_64"
      ]
    },
    "runs32bit": {
      "drop": true
    },
    "graphics": {
      "drop": true
    }
  }
}
