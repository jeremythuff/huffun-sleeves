{
  "format": 2,
  "id": "retroarch-snes9x",
  "version": 1,
  "name": "RetroArch (Snes9x)",
  "description": "Plays Super Nintendo ROMs in RetroArch with the Snes9x core on macOS.",
  "preference": 0,
  "accepts": {
    "system": {
      "any": [
        "snes"
      ]
    }
  },
  "produces": {
    "system": {
      "drop": true
    },
    "os": {
      "set": [
        "macos"
      ]
    },
    "arch": {
      "set": [
        "arm64",
        "x86_64"
      ]
    }
  },
  "runtimes": {
    "retroarch": {
