          "release": "https://buildbot.libretro.com/stable/1.22.2/apple/osx/universal/RetroArch_Metal.dmg",
          "releaseSha256": "81b79121ba26d539064ae13b4d0419a120c3d165afbe656cf5f5412b15fdb434",
          "treeSha256": "32c08e63e98310d1819024d59d890e604bcda9542ef67b45105a534766e3f5d0",
          "root": "RetroArch.app",
          "program": "RetroArch.app/Contents/MacOS/RetroArch",
          "deliverAs": "RetroArch.app"
        }
      ]
    },
    "snes9x": {
      "name": "Snes9x",
      "license": "non-commercial",
      "source": "https://github.com/snes9xgit/snes9x",
      "pins": [
        {
          "version": "2026.10.17",
          "platform": "macos",
          "import": "fetch",
          "url": "https://git.huffs.online/huff-admin/huffun-sleeves/releases/download/sleeve-runtimes-20261016/core-snes9x-2026.10.17-macos.zip",
          "archiveSha256": "4e5336b764a7895cb2757367b3e49ba50895855cc0af284d11464c170d617c84",
          "release": "https://buildbot.libretro.com/nightly/apple/osx/arm64/latest/snes9x_libretro.dylib.zip",
          "releaseSha256": "4e5336b764a7895cb2757367b3e49ba50895855cc0af284d11464c170d617c84",
          "treeSha256": "9852cfbdb58a36464f10563cfc51260bb622738832815fd128303e1dca718ff7",
