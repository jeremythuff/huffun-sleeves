          "program": "cores/snes9x_libretro.dylib",
          "deliverAs": "cores"
        }
      ]
    }
  },
  "templates": {
    "play": {
      "file": "templates/play.sh",
      "escape": "sh"
    },
    "config": {
      "file": "templates/retroarch.cfg",
      "escape": "ini"
    }
  },
  "detect": {
    "profiles": [
      {
        "name": "Super Nintendo ROM",
        "anchor": {
          "file": "**/*.{sfc,smc,fig}"
        },
        "checks": [],
        "params": {
          "rom": {
            "path": "{{anchor.path}}"
          }
        },
        "label": "{{params.rom}}"
      }
    ]
  },
  "deliver": {
    "folder": "{{title}}",
    "clients": {
      "macos": {
        "runtimes": [
          "retroarch",
          "snes9x"
        ],
        "entries": [
          {
            "original": "",
            "to": "rom"
          },
          {
            "template": "play",
            "to": "Play.command",
            "executable": true
          },
          {
            "template": "config",
            "to": "retroarch.cfg"
          },
          {
            "runtime": "retroarch"
          },
          {
            "runtime": "snes9x"
          }
        ]
      }
    }
  },
  "fixtures": [
    {
      "name": "Super Nintendo ROM (macos)",
      "client": "macos",
