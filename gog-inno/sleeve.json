{
  "format": 2,
  "id": "gog-inno",
  "version": 1,
  "name": "Offline Windows installer",
  "description": "Keeps offline installers in the archive; extracts them on Mac with a pinned innoextract, or runs them on Windows. A subsequent Wine path supplies the game launcher on Mac.",
  "accepts": {
    "os": {
      "any": [
        "windows"
      ]
    },
    "installer": {
      "any": [
        "inno"
      ]
    }
  },
  "produces": {
    "installer": {
      "drop": true
    }
  },
  "runtimes": {
    "innoextract": {
      "name": "innoextract",
      "license": "Zlib AND BSL-1.0 AND LGPL-2.1-or-later AND BSD-3-Clause AND bzip2-1.0.6",
      "source": "https://constexpr.org/innoextract/",
      "pins": [
        {
          "version": "1.9-macports-20261016",
          "platform": "macos",
          "import": "fetch",
          "url": "https://git.huffs.online/huff-admin/huffun-sleeves/releases/download/sleeve-runtimes-20261016/innoextract-1.9-macos.zip",
          "archiveSha256": "05dad302f6f5b8137c96b613e89c1dd135df60a3ddf5c41e91512aed163c640a",
          "release": "https://packages.macports.org/innoextract/innoextract-1.9_2.darwin_20.x86_64.tbz2",
          "releaseSha256": "a1db601b5008ecd33fd0660ecfeca72e065c62b7676afc3d08543ab3a80d912d",
          "treeSha256": "10559a582cc62d186e9cf9eed5c06f5f48efe6370a5e4c3a6986abd02ede5beb",
          "root": "innoextract",
          "program": "innoextract/run",
          "deliverAs": "innoextract"
        }
      ]
    }
  },
  "templates": {},
  "detect": {
    "profiles": [
      {
        "name": "Offline setup program",
        "anchor": {
          "file": "setup_*.exe"
        },
        "checks": [
          {
            "pe": "{{anchor.path}}"
          },
          {
            "peResource": "{{anchor.path}}",
            "type": 10,
            "id": 11111,
            "hex": "72446c507453cde6d77b0b2a"
          }
        ],
        "params": {
          "installer": {
            "path": "{{anchor.path}}"
          }
        },
        "label": "{{params.installer}}"
      }
    ]
  },
  "scripts": {
    "install": {
      "macos": [
        {
          "file": "scripts/install.sh",
          "args": [
            "{{params.installer}}"
          ]
        }
      ],
      "windows": [
        {
          "file": "scripts/install.ps1",
          "args": [
            "{{params.installer}}"
          ]
        }
      ]
    }
  },
  "deliver": {
    "folder": "{{title}}",
    "clients": {
      "macos": {
        "runtimes": [
          "innoextract"
        ],
        "entries": [
          {
            "original": "",
            "to": "game"
          },
          {
            "runtime": "innoextract"
          }
        ]
      },
      "windows": {
        "runtimes": [],
        "entries": [
          {
            "original": "",
            "to": "game"
          }
        ]
      }
    }
  },
  "fixtures": [
    {
      "name": "Complete capability data (macos)",
      "client": "macos",
      "state": {
        "os": [
          "windows"
        ],
        "arch": [
          "x86"
        ],
        "huffun-sleeves:installer": [
          "inno"
        ]
      },
      "files": {
        "setup_program.exe": {
          "hex": ""
        },
        "setup_program-1.bin": {
          "text": "slice"
        }
      },
      "expect": {
        "state": {
          "os": [
            "windows"
          ],
          "arch": [
            "x86"
          ]
        },
        "paths": [
          [
            "gog-inno"
          ]
        ],
        "listing": [
          "game/setup_program-1.bin\toriginal\t0644",
          "game/setup_program.exe\toriginal\t0644",
          "innoextract/run\truntime\t0644",
          "licenses/innoextract.txt\tgenerated\t0644"
        ]
      }
    },
    {
      "name": "Complete capability data (windows)",
      "client": "windows",
      "state": {
        "os": [
          "windows"
        ],
        "arch": [
          "x86"
        ],
        "huffun-sleeves:installer": [
          "inno"
        ]
      },
      "files": {
        "setup_program.exe": {
          "hex": ""
        },
        "setup_program-1.bin": {
          "text": "slice"
        }
      },
      "expect": {
        "state": {
          "os": [
            "windows"
          ],
          "arch": [
            "x86"
          ]
        },
        "paths": [
          [
            "gog-inno"
          ]
        ],
        "listing": [
          "game/setup_program-1.bin\toriginal\t0644",
          "game/setup_program.exe\toriginal\t0644"
        ]
      }
    },
    {
      "name": "No matching data",
      "client": "macos",
      "state": {
        "os": [
          "windows"
        ],
        "arch": [
          "x86"
        ],
        "huffun-sleeves:installer": [
          "inno"
        ]
      },
      "files": {},
      "expect": {
        "state": {
          "os": [
            "windows"
          ],
          "arch": [
            "x86"
          ]
        },
        "paths": [],
        "listing": []
      }
    }
  ]
}
