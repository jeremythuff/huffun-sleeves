{
  "name": "ScummVM",
  "description": "Plays SCUMM adventure games with a bundled ScummVM, on current Macs and Windows PCs.",
  "runtimes": {
    "scummvm": {
      "name": "ScummVM",
      "license": "GPL-3.0-or-later",
      "source": "https://downloads.scummvm.org/frs/scummvm/2026.3.0/scummvm-2026.3.0.tar.xz",
      "pins": [
        {
          "version": "2026.3.0",
          "platform": "macos",
          "import": "fetch",
          "release": "https://downloads.scummvm.org/frs/scummvm/2026.3.0/scummvm-2026.3.0-macosx.dmg",
          "releaseSha256": "d483f41a67d389a3bf50832b9a1a054fbeded56fc148216e4f84a06d330d2172",
          "treeSha256": "0a2861f8c98fe6918b30dac3a7ee6cb61c948c968c7fc169789f5fc5dd671542",
          "root": "ScummVM.app",
          "program": "ScummVM.app/Contents/MacOS/scummvm",
          "deliverAs": "ScummVM.app",
          "url": "https://git.huffs.online/huff-admin/huffun-sleeves/releases/download/sleeve-runtimes-20261016/scummvm-2026.3.0-macos.zip",
          "archiveSha256": "c0cc5d43787f82c00f615f4579839318364bde1d6ee3e8abb941a965a3f2d5de"
        },
        {
          "version": "2026.3.0",
          "platform": "windows",
          "import": "fetch",
          "url": "https://git.huffs.online/huff-admin/huffun-sleeves/releases/download/sleeve-runtimes-20261016/scummvm-2026.3.0-windows.zip",
          "archiveSha256": "c14237eb024aadee8cf4fc74394373276cb10469d65b8fe425a6662ee32a1d31",
          "release": "https://downloads.scummvm.org/frs/scummvm/2026.3.0/scummvm-2026.3.0-win32-x86_64.zip",
          "releaseSha256": "ba0af3fd6cf0d281c623d48b23c77a4b4775860d496195155e6ceb281e0fff95",
          "treeSha256": "b584cce4781e7c19a61a97be6a4d047c0c7bfd348f67f7da7046ccafb5354e88",
          "root": "scummvm-2026.3.0-win32-x86_64",
          "program": "scummvm-2026.3.0-win32-x86_64/scummvm.exe",
          "deliverAs": "scummvm"
        }
      ]
    }
  },
  "templates": {
    "launch-macos": {
      "file": "templates/launch-macos.command",
      "escape": "sh"
    },
    "launch-windows": {
      "file": "templates/launch-windows.cmd",
      "escape": "cmd"
    },
    "how-macos": {
      "file": "templates/how-to-play-macos.txt",
      "escape": "text"
    },
    "how-windows": {
      "file": "templates/how-to-play-windows.txt",
      "escape": "text"
    },
    "ini": {
      "file": "templates/scummvm.ini",
      "escape": "ini"
    }
  },
  "detect": {
    "profiles": [
      {
        "name": "Loom (Steam Mac)",
        "anchor": {
          "dir": "**/*.app"
        },
        "base": "{{anchor.path}}/Contents/Resources",
        "checks": [
          {
            "file": "{{base}}/901.LFL",
            "evidence": true,
            "capture": "key"
          },
          {
            "file": "{{base}}/902.LFL",
            "evidence": true
          },
          {
            "file": "{{base}}/903.LFL",
            "evidence": true
          },
          {
            "file": "{{base}}/904.LFL",
            "evidence": true
          },
          {
            "file": "{{base}}/DISK01.LEC",
            "evidence": true
          },
          {
            "file": "{{base}}/CDDA.SOU",
            "evidence": true
          },
          {
            "file": "{{anchor.path}}/Contents/MacOS/Loom",
            "capture": "exe"
          }
        ],
        "params": {
          "target": "scumm:loom",
          "dataRoot": "{{cap.key|dirname}}",
          "indexExecutable": "{{cap.exe}}"
        }
      },
      {
        "name": "Indiana Jones and the Last Crusade (Steam Mac)",
        "anchor": {
          "dir": "**/*.app"
        },
        "base": "{{anchor.path}}/Contents/Resources",
        "checks": [
          {
            "file": "{{base}}/01.LFL",
            "evidence": true,
            "capture": "key"
          },
          {
            "file": "{{base}}/02.LFL",
            "evidence": true
          },
          {
            "count": "{{base}}/**/[0-9][0-9].LFL",
            "min": 20,
            "label": "room files (at least 20)"
          },
          {
            "file": "{{anchor.path}}/Contents/MacOS/The Last Crusade",
            "capture": "exe"
          }
        ],
        "params": {
          "target": "scumm:indy3",
          "dataRoot": "{{cap.key|dirname}}",
          "indexExecutable": "{{cap.exe}}"
        }
      },
      {
        "name": "Indiana Jones and the Fate of Atlantis (Steam Mac)",
        "anchor": {
          "dir": "**/*.app"
        },
        "base": "{{anchor.path}}/Contents/Resources",
        "checks": [
          {
            "file": "{{base}}/ATLANTIS.001",
            "evidence": true,
            "capture": "key"
          },
          {
            "file": "{{base}}/MONSTER.SOU",
            "evidence": true
          },
          {
            "file": "{{anchor.path}}/Contents/MacOS/The Fate of Atlantis",
            "capture": "exe"
          }
        ],
        "params": {
          "target": "scumm:atlantis",
          "dataRoot": "{{cap.key|dirname}}",
          "indexExecutable": "{{cap.exe}}"
        }
      },
      {
        "name": "The Dig (Steam Mac)",
        "anchor": {
          "dir": "**/*.app"
        },
        "base": "{{anchor.path}}/Contents/Resources",
        "checks": [
          {
            "file": "{{base}}/DIG.LA1",
            "evidence": true,
            "capture": "key"
          },
          {
            "file": "{{base}}/DIGMUSIC.BUN",
            "evidence": true
          },
          {
            "file": "{{base}}/DIGVOICE.BUN",
            "evidence": true
          },
          {
            "dir": "{{base}}/VIDEO"
          },
          {
            "file": "{{anchor.path}}/Contents/MacOS/The Dig",
            "capture": "exe"
          }
        ],
        "params": {
          "target": "scumm:dig",
          "dataRoot": "{{cap.key|dirname}}",
          "indexExecutable": "{{cap.exe}}"
        }
      },
      {
        "name": "The Curse of Monkey Island",
        "anchor": {
          "file": "**/COMI.LA0"
        },
        "checks": [
          {
            "file": "{{anchor.path}}"
          },
          {
            "file": "{{base}}/COMI.LA1"
          },
          {
            "file": "{{base}}/COMI.LA2"
          },
          {
            "dir": "{{base}}/RESOURCE"
          }
        ],
        "params": {
          "target": "scumm:comi",
          "dataRoot": "{{anchor.dir|default:\".\"}}"
        }
      }
    ]
  },
  "deliver": {
    "folder": "{{title}} (ScummVM)",
    "clients": {
      "macos": {
        "runtimes": [
          "scummvm"
        ],
        "entries": [
          {
            "template": "launch-macos",
            "to": "Play {{title}}.command",
            "executable": true
          },
          {
            "template": "how-macos",
            "to": "How to play.txt"
          },
          {
            "template": "ini",
            "to": "scummvm.ini"
          },
          {
            "original": "{{params.dataRoot}}",
            "to": "game"
          },
          {
            "original": "{{params.indexExecutable}}",
            "to": "game/{{params.indexExecutable|basename}}",
            "if": "params.indexExecutable"
          },
          {
            "runtime": "scummvm"
          }
        ]
      },
      "windows": {
        "runtimes": [
          "scummvm"
        ],
        "entries": [
          {
            "template": "launch-windows",
            "to": "Play {{title}}.cmd",
            "eol": "crlf"
          },
          {
            "template": "how-windows",
            "to": "How to play.txt",
            "eol": "crlf"
          },
          {
            "template": "ini",
            "to": "scummvm.ini"
          },
          {
            "original": "{{params.dataRoot}}",
            "to": "game"
          },
          {
            "original": "{{params.indexExecutable}}",
            "to": "game/{{params.indexExecutable|basename}}",
            "if": "params.indexExecutable"
          },
          {
            "runtime": "scummvm"
          }
        ]
      }
    }
  },
  "format": 2,
  "id": "scummvm",
  "version": 1,
  "preference": 0,
