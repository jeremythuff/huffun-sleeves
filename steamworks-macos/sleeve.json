          "game/Program.app/Contents/saves/.keep\tgenerated\t0644",
          "game/Program.app/Contents/steam_appid.txt\tgenerated\t0644",
          "game/Program.app/Contents/steam_settings/configs.app.ini\tgenerated\t0644",
          "game/Program.app/Contents/steam_settings/configs.main.ini\tgenerated\t0644",
          "game/Program.app/Contents/steam_settings/configs.overlay.ini\tgenerated\t0644",
          "game/Program.app/Contents/steam_settings/configs.user.ini\tgenerated\t0644",
